DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Laravel owns the API and admin panel. Keep these paths out of the
    # Flutter history fallback so API calls receive JSON and admin sessions
    # reach the Laravel front controller.
    RewriteRule ^api(?:/|$) index.php [L]
    RewriteRule ^admin(?:/|$) index.php [L]

    # Never serve Firebase service-account material from the public web root.
    RewriteRule (^|/).*firebase_service_account.*\.json$ - [F,L,NC]

    # Serve existing files and folders directly (like JS, CSS, assets)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirect everything else (dynamic URLs) to Flutter's index.html
    RewriteRule ^.*$ index.html [L]
</IfModule>

# Flutter's entrypoint and service worker must be revalidated after each
# deployment so browsers and the CDN do not keep loading an older app bundle.
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|flutter_bootstrap.*\.js|flutter_service_worker\.js|main.*\.js)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>
