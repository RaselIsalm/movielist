APP_NAME=DTLive
APP_ENV=local
APP_KEY=base64:GHlKvYv+hmpj0KR+73qH5APmQmZcjVARI0ABBCMcFIM=
APP_DEBUG=true
APP_URL=

# Web URL
WEB_URL=
# Canonical public site used by sitemap and SEO metadata.
SEO_SITE_URL=https://linkviral.seedintrade.com

# API Token
API_TOKEN=

# Pagination
PAGE_LIMIT=10

# ON/OFF
DEMO_MODE=OFF

# Project Version
VERSION=1.0

# Database
DB_CONNECTION=mysql
DB_PORT=3306
DB_HOST=localhost
DB_DATABASE=dt_live
DB_USERNAME=root
DB_PASSWORD=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=21720
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Store all uploaded videos, images, subtitles, and artwork in Cloudflare R2.
# The local disk is reserved for temporary upload staging and framework state.
DTLIVE_R2_ONLY=true
# Minimum free VPS bytes kept as a safety reserve for non-R2 fallback uploads.
DTLIVE_UPLOAD_MIN_FREE_BYTES=1073741824

# Media delivery. Set the R2 custom CDN domain for direct browser playback.
# Set this to the R2 custom domain after its CORS and cache rules are configured.
DTLIVE_MEDIA_PUBLIC_URL=
DTLIVE_MEDIA_URL_TTL=60
DTLIVE_MEDIA_PROXY=true

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

