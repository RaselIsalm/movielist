# Keep source files consistent between macOS and Windows.
* text=auto eol=lf

# Windows-native scripts keep CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.apk binary
*.ipa binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
